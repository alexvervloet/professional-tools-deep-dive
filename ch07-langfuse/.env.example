# Copy to .env before `docker compose up -d`. These are LOCAL-ONLY, self-hosted
# demo credentials for a Langfuse instance that lives on your machine and talks
# to nobody — not real API keys to any external service. Committing the example
# (not the .env) keeps the chapter reproducible without leaking anything real.
#
# The LANGFUSE_INIT_* vars ask the Langfuse container to auto-create an org,
# a project, and a login on first boot, so you get working keys with no
# click-through. Docker Compose reads this file automatically from this dir.

# --- headless bootstrap: an org, a project, a user, and a keypair ---
LANGFUSE_INIT_ORG_ID=deepdives
LANGFUSE_INIT_ORG_NAME=DeepDives
LANGFUSE_INIT_PROJECT_ID=protools-ch07
LANGFUSE_INIT_PROJECT_NAME=professional-tools-ch07
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-ch07-local-demo
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-ch07-local-demo
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=You
LANGFUSE_INIT_USER_PASSWORD=changeme-local-only

# --- these match what with_tool.py reads ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-ch07-local-demo
LANGFUSE_SECRET_KEY=sk-lf-ch07-local-demo
